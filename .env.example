; Server-only settings. Use quoted values; this file uses PHP INI syntax.
APP_NAME="The Allin Family API"
APP_ENV="local"
APP_ORIGIN="http://127.0.0.1:5173"
; Generate a random key locally; never use this placeholder.
APP_KEY=""
; 0 is for local HTTP only. Production requires 1 and HTTPS.
SESSION_COOKIE_SECURE="0"
SESSION_IDLE_SECONDS="1800"
SESSION_LIFETIME_SECONDS="43200"

; The isolated local MariaDB instance uses 3307. Use Trilogy's settings on deployment.
DB_HOST="127.0.0.1"
DB_PORT="3307"
DB_NAME="theallinfamily"
DB_USER="allinfamily_app"
DB_PASSWORD=""

; Optional shared private path for the API maintenance gate and CLI release tool.
; Defaults to dirname(SESSION_DIRECTORY)/database-releases. On production this
; must be OUTSIDE public_html, writable by the API and the deployment CLI user.
; DATABASE_RELEASE_DIRECTORY="/home/account/private/allin-family/database-releases"

; Optional absolute private directory, writable by PHP and never directly web-served.
; Defaults to this API checkout's ignored .local/memory-photos directory.
; MEMORY_PHOTO_DIRECTORY="/home/account/private/family-photos"
